{
  "name": "@basesentinel/mcp",
  "version": "1.0.0",
  "description": "MCP server: scan Base contracts via BaseSentinel (HTTP 402 + USDC tx-hash proof).",
  "type": "module",
  "bin": {
    "basesentinel-mcp": "./bin/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlackSwanLabsOS/BaseSentinel.git",
    "directory": "packages/mcp-basesentinel"
  },
  "homepage": "https://blackswanlabs.pl",
  "bugs": {
    "url": "https://github.com/BlackSwanLabsOS/BaseSentinel/issues"
  },
  "author": "BlackSwan Labs",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "base",
    "x402",
    "basesentinel"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "viem": "^2.33.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18"
  }
}
