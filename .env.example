# Local only — do not commit real secrets.
#
# Worker secrets (wrangler secret put / .dev.vars):
# ALCHEMY_API_KEY=...
# ADMIN_API_KEY=...
#
# Optional RPC split (also settable as wrangler [vars]):
# LOGS_RPC_URL=https://mainnet.base.org
# CRITICAL_RPC_URL=   # leave empty → Alchemy via ALCHEMY_API_KEY
#
# x402-list paid resubmit:
# X402_LIST_PRIVATE_KEY=0x...
# X402_LIST_EMAIL=you@example.com
